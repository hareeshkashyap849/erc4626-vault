# Foundry build artefacts
out/
cache/
broadcast/

# The compiler that `foundry.toml` points at, copied here by the setup scripts.
# A 9 MB binary does not belong in the repository, and a clone without it still builds:
# Foundry falls back to resolving `solc_version` itself.
.solc/

# Dependencies are vendored deliberately (the sandbox cannot run `forge install`,
# which shells out to git submodule). Keeping them in the repository makes the
# build reproducible with no network access, so they are NOT ignored.
# If you prefer submodules, delete lib/ and run:
#   forge install foundry-rs/forge-std@v1.16.2
#   forge install OpenZeppelin/openzeppelin-contracts@v5.7.0

# Secrets. Never commit a real key: the deployment script reads
# PRIVATE_KEY from the environment, and this file is only a template.
.env
.env.*
!.env.example

# Coverage output
lcov.info
coverage/

# Python (slither / halmos)
__pycache__/
*.pyc
crytic-export/

# Medusa property-fuzzing corpus and crytic-compile output (regenerable)
medusa-corpus/
crytic-export/
slither_results.json
.medusa-artifact-hash

# Local dev chain state and its address record. Both describe one disposable
# chain started by scripts/dev-chain.ps1; committing them would be actively
# misleading in a fresh clone, where those addresses do not exist.
deployments/anvil-state.json
deployments/local.json

# Screenshots from web/tools/browser-test.mjs. Output, not source: they show one
# particular chain state, so a committed copy would be stale the moment anyone
# deposits. Regenerate with:
#   node web/tools/browser-test.mjs --keep-screenshots
web/tools/screenshots/

# The static site assembled by scripts/build-static-site.mjs, and the workflow's copy of
# it. Generated output: `api/config` inside it is a copy of a deployment record, and a
# committed copy would be a second place for an address to be wrong. The script is the
# thing to read, not its output.
.site/
_site/

# Generated by `web/tools/screenshot-live.mjs` and the live-browser checks.
web/tools/live-*.png